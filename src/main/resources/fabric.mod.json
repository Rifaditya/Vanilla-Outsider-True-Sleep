    "icon": "assets/vanilla-outsider-true-sleep/icon.png",
    "authors": [
        "DasikIgaijin"
    ],
    "contact": {
        "homepage": "https://github.com/Rifaditya",
        "sources": "https://github.com/Rifaditya/Vanilla-Outsider-True-Sleep",
        "issues": "https://github.com/Rifaditya/Vanilla-Outsider-True-Sleep/issues"
    },
    "license": "GPL-3.0-or-later",
    "environment": "*",
    "entrypoints": {
        "main": [
            "net.vanillaoutsider.truesleep.TrueSleep"
        ],
